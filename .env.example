FLASK_SECRET_KEY=replace-this-with-a-random-secret
FLASK_DEBUG=1
# # Set these values from the TiDB Cloud cluster's Connect dialog.
# Keep the downloaded CA certificate outside version control.
DB_HOST=gateway01-region.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USERNAME=your-username
DB_PASSWORD=your-password
DB_DATABASE=your-database
TIDB_CA_PATH=path/to/tidb-ca.pem
MAILTRAP_API_TOKEN=your-mailtrap-api-token
MAILTRAP_SENDER_EMAIL=verified-sender@example.com
MAILTRAP_SENDER_NAME=StormHacks
