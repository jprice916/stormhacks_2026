{
  "name": "weekly-screen-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev:vite": "vite",
    "dev:flask": "..\\.venv\\Scripts\\python.exe -m flask --app ..\\run.py run --host 127.0.0.1 --port 5001 --no-reload",
    "dev": "concurrently -k -n \"vite,flask\" -c \"cyan,magenta\" \"npm run dev:vite\" \"npm run dev:flask\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
